# ===============================================
# AuthShield Environment Configuration Template
# Copy this file to .env and configure with your values
# ===============================================

# Database Connection
MONGO_URL=mongodb+srv://<db_user>:<db_password>@authshield.mongodb.net/?appName=authshield
MONGO_DB_NAME=auth_project

# JWT Secrets & Security
SECRET_KEY=generate_a_random_32_byte_hex_key_for_production
ALGORITHM=HS256

# Token Lifetime Policy
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=15
